<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="cr.ac.proyecto.controller.PrincipalController"
      alignment="CENTER"
      spacing="20"
      prefWidth="900"
      prefHeight="600">

    <Label text="Préstamos de equipos"
           style="-fx-font-size: 28px; -fx-font-weight: bold;"/>

    <Button text="Registrar personas y equipos"
            onAction="#abrirRegistro"
            prefWidth="280"/>

    <Button text="Consultar información"
            onAction="#abrirConsulta"
            prefWidth="280"/>

    <Button text="Gestionar préstamos y devoluciones"
            onAction="#abrirGestion"
            prefWidth="280"/>

    <Label fx:id="mensaje"
           wrapText="true"
           maxWidth="500"/>

</VBox>